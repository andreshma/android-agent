# Normalize line endings: LF in the repo, auto-converted in the working tree.
* text=auto eol=lf

# Keep Windows batch files as CRLF if any are ever added.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets (no diff/merge, no eol conversion).
*.png binary
*.jpg binary
*.img binary
*.zip binary
